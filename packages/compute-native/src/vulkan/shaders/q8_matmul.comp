#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint8_t w[]; };
layout(set = 0, binding = 1) readonly buffer Scales { float s[]; };
layout(set = 0, binding = 2) readonly buffer Inputs { float x[]; };
layout(set = 0, binding = 3) writeonly buffer Outputs { float y[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.N) return;
}
