#version 450
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Inputs { float16_t x[]; };
layout(set = 0, binding = 1) writeonly buffer KV_Cache { float16_t kv[]; };

layout(push_constant) uniform PushConstants {
    uint elements;
    uint slot;
} pc;

void main() {
    uint tid = gl_GlobalInvocationID.x;
}
