#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint w[]; };
layout(set = 0, binding = 1) readonly buffer Scales { float16_t s[]; };
layout(set = 0, binding = 2) readonly buffer Inputs { float16_t x[]; };
layout(set = 0, binding = 3) writeonly buffer Outputs { float16_t y[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.N) return;
    
    float16_t sum = float16_t(0.0);
    // Dummy Q4 matmul
    for (uint i = 0; i < pc.K; ++i) {
        sum += x[i];
    }
    y[row] = sum;
}
